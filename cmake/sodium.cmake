# libsodium (ISC), for SHA-256 and Ed25519. From the system (libsodium-dev, vcpkg, brew),
# found by pkg-config or by its header and library; -DSODIUM_ROOT=dir points elsewhere.
find_package(PkgConfig QUIET)
if(PkgConfig_FOUND)
  pkg_check_modules(SODIUM QUIET IMPORTED_TARGET libsodium)
endif()
add_library(liveops_sodium INTERFACE)
if(SODIUM_FOUND)
  target_link_libraries(liveops_sodium INTERFACE PkgConfig::SODIUM)
else()
  find_path(SODIUM_INCLUDE_DIR sodium.h HINTS ${SODIUM_ROOT}/include)
  find_library(SODIUM_LIBRARY NAMES sodium libsodium HINTS ${SODIUM_ROOT}/lib)
  if(NOT SODIUM_INCLUDE_DIR OR NOT SODIUM_LIBRARY)
    message(FATAL_ERROR "libsodium not found: install libsodium-dev, or set SODIUM_ROOT")
  endif()
  target_include_directories(liveops_sodium INTERFACE ${SODIUM_INCLUDE_DIR})
  target_link_libraries(liveops_sodium INTERFACE ${SODIUM_LIBRARY})
endif()
add_library(liveops::sodium ALIAS liveops_sodium)
